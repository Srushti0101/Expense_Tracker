<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*"
           modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform
        processPath="D:\Politeforce Softtech\expense-tracker\.venv\Scripts\python.exe"
        arguments="-m waitress --listen=127.0.0.1:%HTTP_PLATFORM_PORT% config.wsgi:application"
        stdoutLogEnabled="true"
        stdoutLogFile="D:\Politeforce Softtech\expense-tracker\backend\logs\python.log"
        startupTimeLimit="60"
        requestTimeout="00:04:00">
      <environmentVariables>
        <environmentVariable name="PYTHONPATH"
            value="D:\Politeforce Softtech\expense-tracker\backend" />
      </environmentVariables>
    </httpPlatform>
  </system.webServer>
</configuration>